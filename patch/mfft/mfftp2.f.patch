*** 11,17 ****
  *              THE SHUFFLING IS EFFECTIVELY AN 'INTEGER BIT REVERSAL'
  *              ONLY IN CASE OF RADIX-2 ALGORITHMS.
  *
!       INTEGER INDX(0:*),I2(0:*),IW(14)
        PARAMETER (MAXFAC=3)
        INTEGER FACTOR(MAXFAC)
        DATA (FACTOR(I),I=1,MAXFAC)/2,3,5/
