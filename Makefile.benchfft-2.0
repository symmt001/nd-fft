###########################################################################

# C flags that must be used:
BENCH_CFLAGS = $(INCLUDE_FLAGS) -DHAVE_NIELSEN

CC = cc
CFLAGS = -Ae +O2 +Oall
F77 = f77
FFLAGS = -O +ppu
F90 = f90
F90FLAGS = -O +ppu

# SGI:
# CFLAGS = -DUSE_SGIMATH -mips4  -O3 -64 -mips4 -WOPT:rsv_bits=4020 -IPA
# FFLAGS = -64 -mips4 -O3

