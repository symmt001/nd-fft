	$(CC) $(CFLAGS) $(OBJECTS) $(LIBRARIES) -o $@

submit: bench
	./submit-script
	cat submit.txt | mail "benchfft@theory.lcs.mit.edu"

clean:
	rm -f $(OBJECTS)

realclean: clean
	rm -f bench
