LIBPATHS = -L$(FFTWDIR)/fftw/.libs -L$(FFTWDIR)/src \
	   -L$(FFTWDIR)/rfftw/.libs

INCLUDE_FLAGS = -I. -I$(FFTWDIR)/fftw -I$(FFTWDIR)/src -I$(FFTWDIR)/rfftw

# Put libraries that you need to link in here:
