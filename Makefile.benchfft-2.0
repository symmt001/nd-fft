all: bench

.c.o:
	$(CC) -c $(CFLAGS) $(BENCH_CFLAGS) \
		-DCFLAGS="\"$(CFLAGS)\"" \
		-DFFLAGS="\"$(FFLAGS)\"" \
		$< -o $@

.f.o:
	$(F77) -c $(FFLAGS) $< -o $@

